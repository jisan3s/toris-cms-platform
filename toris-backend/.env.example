PORT=5001
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster-name>.mongodb.net/toris_cms?retryWrites=true&w=majority&appName=toris
JWT_SECRET=<generate-strong-random-32-plus-chars>
USER_JWT_SECRET=<generate-strong-random-32-plus-chars>
USER_REFRESH_JWT_SECRET=<generate-strong-random-32-plus-chars>
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=<set-strong-owner-password>
ALLOWED_ADMIN_EMAILS=admin@example.com,owner@example.com

# Cloudinary settings
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=toris

# Optional: comma separated list of allowed origins for CORS (production, leave blank to restrict)
CORS_ALLOWED_ORIGINS=https://yourdomain.com

# Optional rate limits (defaults shown)
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
USER_LOGIN_RATE_LIMIT_WINDOW_MS=900000
USER_LOGIN_RATE_LIMIT_MAX=10
USER_FORGOT_RATE_LIMIT_WINDOW_MS=900000
USER_FORGOT_RATE_LIMIT_MAX=8
USER_RESET_RATE_LIMIT_WINDOW_MS=900000
USER_RESET_RATE_LIMIT_MAX=12
OWNER_AUTH_RATE_LIMIT_WINDOW_MS=900000
OWNER_AUTH_RATE_LIMIT_MAX=12
ADMIN_AUTH_RATE_LIMIT_WINDOW_MS=900000
ADMIN_AUTH_RATE_LIMIT_MAX=12
RESET_PASSWORD_TOKEN_TTL_MINUTES=15
EMAIL_VERIFY_TOKEN_TTL_MINUTES=1440
USER_EMAIL_VERIFY_REQUIRED=false
USER_ACCESS_TOKEN_TTL=30m
USER_REFRESH_TOKEN_TTL=30d
USER_REFRESH_TOKEN_DAYS=30
EMAIL_WORKER_POLL_MS=5000
EMAIL_WORKER_MAX_ATTEMPTS=5
DISABLE_EMAIL_WORKER=false

# Contact form email settings (Gmail SMTP with App Password)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=<gmail-app-password>
CONTACT_FROM_EMAIL=you@gmail.com
CONTACT_NOTIFY_TO=owner@example.com
FRONTEND_ORIGIN=http://localhost:4200
ERROR_TRACKER_WEBHOOK=

# Enable self-registration for admins (set to 'true' to allow the first admin created from frontend)
ADMIN_SELF_REGISTER=false
